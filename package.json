{
  "name": "typescript-fastify-di-api",
  "version": "1.0.0",
  "description": "Template for a TypeScript Fastify application with Dependency Injection",
  "type": "module",
  "main": "dist/main.js",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "scripts": {
    "prepare": "husky install",
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^4.1.10",
    "husky": "^9.1.7",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "unplugin-swc": "^1.5.10",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.0.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0"
  }
}
